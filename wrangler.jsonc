{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mirror-house-melbourne",
  // ZMZ Services Cloudflare account (zarko-ddc.workers.dev). Not a secret.
  "account_id": "ddc4b57d62fbeeb269f883673e5903c4",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // The site lives in ./public. The Worker runs first for the API and the admin pages;
  // everything else is served straight from assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },

  // No database_id on purpose: on the first `wrangler deploy` (Workers Builds), Wrangler's
  // automatic provisioning creates "mirror-house-db" and later deploys find it by name.
  // `npm run deploy` then applies migrations/ to it. Locally, `wrangler dev` uses a local copy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirror-house-db",
      "migrations_dir": "migrations"
    }
  ]
}
