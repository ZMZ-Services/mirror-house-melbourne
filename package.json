{
  "name": "mirror-house-melbourne",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "migrate": "node scripts/migrate.mjs",
    "dev": "node scripts/build.mjs && netlify dev --offline",
    "test": "node --test --test-concurrency=1 --test-timeout=30000 tests/*.test.mjs",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "@netlify/database": "^2.0.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "netlify-cli": "^27.19.0"
  }
}
